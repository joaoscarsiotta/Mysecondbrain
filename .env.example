# Escolha seu provedor de LLM: "openai" ou "anthropic"
LLM_PROVIDER=openai

# Chave da API OpenAI (necessária sempre, pois embeddings usam OpenAI)
OPENAI_API_KEY=sk-...

# Chave da API Anthropic (necessária apenas se LLM_PROVIDER=anthropic)
ANTHROPIC_API_KEY=sk-ant-...

# Modelos (opcional - valores padrão já configurados)
# EMBEDDING_MODEL=text-embedding-3-small
# LLM_MODEL=gpt-4o
# LLM_MODEL=claude-sonnet-4-20250514
